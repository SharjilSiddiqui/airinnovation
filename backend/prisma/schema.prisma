generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  location    String?
  year        Int?
  category    String?
  featured    Boolean  @default(false)

  projectPath String
  entryFile   String   @default("index.html")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}